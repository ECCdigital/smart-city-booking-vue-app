# !! THIS IS AN EXAMPLE CONFIGURATION FILE !!
# Copy this file to .env and adjust the values to your needs

# The base url of the backend server to reach the API
VUE_APP_SERVER_BASE_URL=http://localhost:8081

# Auth mode: direct (default) = SPA calls API with Bearer tokens in localStorage
# Opt-in bff = SPA calls Admin BFF with HttpOnly cookies (shared session with Storefront)
# Local: npm run bff:dev + vue proxy. Docker: same UI image starts embedded BFF when mode=bff.
# The BFF also reads this root `.env` (UI names = BFF config; no separate bff/.env required).
# Local example: VUE_APP_BFF_BASE_URL=/api  |  Production-like: /admin/api
# See docs/adr/0001-optional-admin-bff-shared-session.md
# VUE_APP_AUTH_MODE=direct
# VUE_APP_BFF_BASE_URL=/admin/api
# PUBLIC_ORIGIN=http://localhost:8080
# Dev proxy target for the Admin BFF (must match bff PORT)
# BFF_DEV_URL=http://localhost:3001

# The Application Title
VUE_APP_NAME=Amt Süderbrarup - Buchungsplattform

# Default file extensions allowed in file uploads
VUE_APP_ALLOWED_EXT_DEFAULT=pdf,doc,docx,xls,xlsx,ppt,pptx,txt,zip,rar,7z,md

# Default file extensions allowed in image uploads
VUE_APP_ALLOWED_EXT_IMAGES=jpg,jpeg,png,svg,ico

# Set to true to enable the production mode
VUE_APP_IS_PRODUCTION=false


# Contact information
VUE_APP_CONTACT_ADDRESS=Amt Süderbrarup, team Allee 22, 24392 Süderbrarup
VUE_APP_CONTACT_URL=https://www.amt-suederbrarup.de/kontakt

# Theme colors for the light theme
VUE_APP_PRIMARY_COLOR=
VUE_APP_SECONDARY_COLOR=
VUE_APP_ACCENT_COLOR=
VUE_APP_ERROR_COLOR=
VUE_APP_INFO_COLOR=
VUE_APP_SUCCESS_COLOR=
VUE_APP_WARNING_COLOR=
VUE_APP_BODY_COLOR=
VUE_APP_DARKGREY_COLOR=

# Theme colors for the dark theme
VUE_APP_PRIMARY_COLOR_DARK=
VUE_APP_SECONDARY_COLOR_DARK=
VUE_APP_ACCENT_COLOR_DARK=
VUE_APP_ERROR_COLOR_DARK=
VUE_APP_INFO_COLOR_DARK=
VUE_APP_SUCCESS_COLOR_DARK=
VUE_APP_WARNING_COLOR_DARK=
VUE_APP_DARKGREY_COLOR_DARK=

# The API key for the Usersnap feedback tool
VUE_APP_USERSNAP_API_KEY=

#SSO configuration
VUE_APP_SILENT_SSO_ENABLED=

# Bookable edit expert mode: unset = always expert (no toggle); true/false = default + show toggle
VUE_APP_BOOKABLE_EXPERT_MODE_DEFAULT=
