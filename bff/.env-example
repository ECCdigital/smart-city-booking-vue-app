# Backend API origin (no trailing slash)
API_BASE_URL=http://localhost:8081

# Listen port
PORT=3001

# production → cookie secure: true (unless overridden)
NODE_ENV=development

# Optional override for cookie Secure flag (true|false)
# COOKIE_SECURE=true

# Browser-facing BFF path prefix (vue proxy /api or nginx /admin/api).
# Used for Keycloak redirect_uri = {origin}{BFF_PUBLIC_PATH}/auth/sso/callback
BFF_PUBLIC_PATH=/api

# Browser-facing origin (required behind vue-cli proxy so redirect_uri is not :300x).
# Also enables CSRF Origin/Referer checks on mutating requests (see bff/src/csrf.js).
PUBLIC_ORIGIN=http://localhost:8080

# Admin SPA base path for post-SSO redirects ("" or "/admin")
# ADMIN_SPA_BASE_PATH=

# Comma-separated browser origins allowed for credentialed CORS in dev
# Leave unset to allow same-origin only (typical behind nginx)
# CORS_ORIGINS=http://localhost:8080
