# Optional BFF-only overrides. Prefer the root Admin UI `.env` — this process
# loads `../.env` then `bff/.env`, and accepts the UI names as aliases:
#
#   API_BASE_URL      ← VUE_APP_SERVER_BASE_URL
#   BFF_PUBLIC_PATH   ← VUE_APP_BFF_BASE_URL
#   ADMIN_SPA_BASE_PATH ← BASE_URL
#   COOKIE_SECURE     ← VUE_APP_IS_PRODUCTION (when COOKIE_SECURE unset)
#   PUBLIC_ORIGIN     (same name in UI Docker / shared-session deploy)
#
# Example root `.env` for local BFF mode:
#   VUE_APP_AUTH_MODE=bff
#   VUE_APP_SERVER_BASE_URL=http://localhost:8081
#   VUE_APP_BFF_BASE_URL=/api
#   PUBLIC_ORIGIN=http://localhost:8080
#   BASE_URL=/admin   # optional; used for post-SSO SPA redirects in Docker

# Listen port (BFF-only; no UI equivalent)
PORT=3001

# production → cookie secure defaults true (unless COOKIE_SECURE / VUE_APP_IS_PRODUCTION)
NODE_ENV=development

# Comma-separated browser origins allowed for credentialed CORS in dev
# Leave unset to allow same-origin only (typical behind nginx / vue proxy)
# CORS_ORIGINS=http://localhost:8080
